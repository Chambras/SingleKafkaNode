# Copy to terraform.tfvars and adjust for your environment.
# Variables listed here are the most important to review before running `terraform apply`.

# Azure region and naming
location = "eastus2"
suffix   = "mz"
rgName   = "SingleNodeRG"

# Must be globally unique, 3-24 chars, lowercase letters and numbers only.
# An ADLS Gen2 account is also created as "<storageAccountName>adsl".
storageAccountName = "mzvclstrdataingested"

# Public IPs allowed to SSH/HTTP into the Kafka VM. Restrict to operator IPs.
sourceIPs = ["74.96.174.80"]

# Absolute path is safest. '~' is expanded automatically.
sshKeyPath = "~/.ssh/vm_ssh.pub"
vmUserName = "kafkaAdmin"

# Kafka VM image. RHEL 7-RAW-CI is deprecated/unavailable in some regions.
vmImagePublisher = "RedHat"
vmImageOffer     = "RHEL"
vmImageSku       = "8_10"
vmImageVersion   = "latest"

# Java runtime installed by cloud-init. Solace connector 3.3.0 requires Java 11
# (class file version 55); Java 8 only supports class file version 52.
javaPackage = "java-11-openjdk-devel"

# Kafka version installed by cloud-init. Must match an artifact published under
# https://archive.apache.org/dist/kafka/<kafkaVersion>/kafka_<kafkaScalaVersion>-<kafkaVersion>.tgz
kafkaVersion      = "2.3.0"
kafkaScalaVersion = "2.12"

# Databricks: keep secure cluster connectivity on (no public IPs on workers).
# Set to false only if you have a specific need for public worker IPs.
databricksNoPublicIP = true

# Databricks workspace name (appended to suffix).
workspaceName = "DBWorkspaceSingleNode"

# Optional: tags applied to all resources.
# tags = {
#   Environment = "Dev"
#   Project     = "Learning"
#   BillingCode = "Internal"
# }
